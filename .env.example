# Скопируйте этот файл в .env и заполните значения. .env в .gitignore.
#
# Используется и docker compose (POSTGRES_*), и приложением (REXTER_DATABASE_URL),
# поэтому держите пароль в одном месте.

POSTGRES_DB=rexter_db
POSTGRES_USER=rexter
POSTGRES_PASSWORD=смените-этот-пароль

# Строка подключения для uvicorn. Пароль должен совпадать с POSTGRES_PASSWORD.
REXTER_DATABASE_URL=postgresql+asyncpg://rexter:смените-этот-пароль@localhost:5432/rexter_db

# Необязательно. CORS нужен только если фронтенд открыт с другого домена;
# в штатной схеме (статика и API на одном origin) оставьте пустым.
# Пример: https://rexter.example.com,https://www.rexter.example.com
REXTER_ALLOWED_ORIGINS=

# Кулдаун показов рекомендаций. Redis поднимается docker compose на localhost.
# Пустое значение = хранить показы в памяти процесса (работает, но сбрасывается
# при перезапуске и не делится между воркерами).
REXTER_REDIS_URL=redis://127.0.0.1:6379/0
REXTER_COOLDOWN_TTL=86400

# Каталог артефактов LightFM (по умолчанию <корень проекта>/data/artifacts).
# REXTER_ARTIFACTS_DIR=/opt/rexter/data/artifacts
